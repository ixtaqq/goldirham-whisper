{{- /*
  RSS feed at /index.xml — only upcoming signals, sorted ascending.
*/ -}}
{{- $today := now.Format "2006-01-02" -}}
{{- $upcoming := where hugo.Data.events "date" ">=" $today -}}
{{- $upcoming = sort $upcoming "date" -}}
{{- $upcoming = first 50 $upcoming -}}
{{- $dateFormat := "Mon, 02 Jan 2006 15:04:05 -0700" -}}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>The Goldirham Whisper — Upcoming Signals</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description }}</description>
    <language>{{ site.Language.Locale }}</language>
    <generator>Hugo — Goldirham Whisper</generator>
    <lastBuildDate>{{ now.Format $dateFormat }}</lastBuildDate>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml"/>
    {{ range $upcoming }}
      <item>
        <title>{{ .title }} — {{ .source }}</title>
        <link>{{ .url }}</link>
        <guid isPermaLink="false">event/#{{ urlize .title }}</guid>
        <pubDate>{{ time .date | dateFormat $dateFormat }}</pubDate>
        <description>{{ .description }}</description>
        <category>{{ .type }}</category>
      </item>
    {{ end }}
  </channel>
</rss>